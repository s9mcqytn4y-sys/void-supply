# ==============================================================================
# VOID SUPPLY - ENVIRONMENT VARIABLES TEMPLATE
# Salin file ini menjadi .env.local untuk development lokal
# ==============================================================================

# Database (PostgreSQL 18 - Drizzle ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/void_supply"

# Next.js Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Midtrans Snap Payment Gateway
# Sandbox: https://dashboard.sandbox.midtrans.com/
# Production: https://dashboard.midtrans.com/
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxx"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxx"
MIDTRANS_IS_PRODUCTION=false

# Biteship Logistics & Shipping Aggregator
# https://biteship.com/id/docs/api
BITESHIP_API_KEY="biteship_test.xxxxxxxxxxxx"

# Sentry Monitoring & Observability
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
