# ==============================================================================
# VOID SUPPLY - ENVIRONMENT VARIABLES TEMPLATE
# Salin file ini menjadi .env.local untuk development lokal
# ==============================================================================

# Aplikasi Next.js
NEXT_PUBLIC_APP_NAME="VOID Supply"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (PostgreSQL 18 - Drizzle ORM)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/void_supply"
DB_HOST="127.0.0.1"
DB_PORT="5432"
DB_DATABASE="void_supply"
DB_USERNAME="postgres"
DB_PASSWORD="postgres"

# Gateway Pembayaran Midtrans (Sandbox / Snap API)
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxx"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxx"
MIDTRANS_MERCHANT_ID="G357841497"
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_ALLOWED_IP="103.101.228.215"
MIDTRANS_WEBHOOK_URL="http://localhost:3000/api/midtrans/webhook"

# Logistik & Pelacakan Biteship (Sandbox / Test API)
BITESHIP_API_KEY="biteship_test.xxxxxxxxxxxx"
BITESHIP_ORIGIN_POSTAL_CODE="55281"
BITESHIP_ORIGIN_CITY="Sleman, D.I. Yogyakarta"

# RajaOngkir Gateway (Komerce / RajaOngkir API)
RAJAONGKIR_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RAJAONGKIR_PACKAGE="starter"
RAJAONGKIR_BASE_URL="https://api.rajaongkir.com/starter"
RAJAONGKIR_ORIGIN_CITY_ID="152"
RAJAONGKIR_ORIGIN_SUBDISTRICT_ID="2098"
RAJAONGKIR_ORIGIN_POSTAL_CODE="10560"
RAJAONGKIR_COURIERS="jne,pos,tiki"

# Sentry Monitoring & Observability
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
