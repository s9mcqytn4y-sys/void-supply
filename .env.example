# ==============================================================================
# VOID SUPPLY - ENVIRONMENT VARIABLES TEMPLATE
# Salin file ini menjadi .env.local untuk development lokal
# ==============================================================================

# Aplikasi Next.js
NEXT_PUBLIC_APP_NAME="VOID Supply"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Database (PostgreSQL 18 - Drizzle ORM)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/void_supply"
DB_HOST="127.0.0.1"
DB_PORT="5432"
DB_DATABASE="void_supply"
DB_USERNAME="postgres"
DB_PASSWORD="postgres"

# Database Staging / Production (Isi saat siap deployment hosting)
DATABASE_URL_STAGING=""
DATABASE_URL_PRODUCTION=""

# ==============================================================================
# GATEWAY PEMBAYARAN MIDTRANS (SNAP API)
# ==============================================================================
# Penentu Lingkungan Aktif: false = Sandbox, true = Production
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_ALLOWED_IP="103.101.228.215"
MIDTRANS_WEBHOOK_URL="http://localhost:3000/api/midtrans/webhook"

# Kredensial Midtrans Sandbox (Pengujian Lokal & Staging)
MIDTRANS_SERVER_KEY_SANDBOX="SB-Mid-server-xxxxxxxxxxxx"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY_SANDBOX="SB-Mid-client-xxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY_SANDBOX="SB-Mid-client-xxxxxxxxxxxx"
MIDTRANS_MERCHANT_ID_SANDBOX="G357841497"

# Kredensial Midtrans Production (Transaksi Dana Nyata)
MIDTRANS_SERVER_KEY_PRODUCTION=""
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY_PRODUCTION=""
MIDTRANS_CLIENT_KEY_PRODUCTION=""
MIDTRANS_MERCHANT_ID_PRODUCTION=""

# Variabel Aktif Midtrans (Fallback langsung / Resolusi otomatis runtime)
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxx"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxx"
MIDTRANS_MERCHANT_ID="G357841497"

# ==============================================================================
# LOGISTIK & PELACAKAN BITESHIP API
# ==============================================================================
BITESHIP_ORIGIN_POSTAL_CODE="10560"
BITESHIP_ORIGIN_CITY="Jakarta Pusat, DKI Jakarta"

# Kredensial Biteship Sandbox / Testing API
BITESHIP_API_KEY_SANDBOX="biteship_test.xxxxxxxxxxxx"

# Kredensial Biteship Production (Penjemputan Kurir Nyata)
BITESHIP_API_KEY_PRODUCTION=""

# Variabel Aktif Biteship (Fallback langsung)
BITESHIP_API_KEY="biteship_test.xxxxxxxxxxxx"

# ==============================================================================
# RAJAONGKIR GATEWAY (KOMERCE / RAJAONGKIR API)
# ==============================================================================
RAJAONGKIR_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RAJAONGKIR_PACKAGE="starter"
RAJAONGKIR_BASE_URL="https://api.rajaongkir.com/starter"
RAJAONGKIR_ORIGIN_CITY_ID="152"
RAJAONGKIR_ORIGIN_SUBDISTRICT_ID="2098"
RAJAONGKIR_ORIGIN_POSTAL_CODE="10560"
RAJAONGKIR_COURIERS="jne,pos,tiki"

# ==============================================================================
# SENTRY MONITORING & OBSERVABILITY
# ==============================================================================
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
