# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Code files must always have LF line endings
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
.editorconfig text eol=lf
.prettierrc text eol=lf
.gitignore text eol=lf

# Binary media files must not be touched
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
